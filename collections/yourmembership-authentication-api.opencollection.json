            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://ws.yourmembership.com/Ams/Authenticate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticate to the YourMembership REST API. Confirmed endpoint. Returns the session context / token subsequently presented on /Ams requests. Requires that the organization has licensed the REST API."
        }
      ]
    }
  ],
  "bundled": true
